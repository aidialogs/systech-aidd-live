# Пример файла .env для запуска через Docker Compose
# Скопируйте этот файл в .env и заполните значения

# =============================================================================
# Telegram Bot
# =============================================================================
# Токен Telegram бота (получить через @BotFather)
BOT_TOKEN=your_telegram_bot_token_here

# =============================================================================
# LLM API (OpenRouter, OpenAI, или другой OpenAI-compatible провайдер)
# =============================================================================
# API ключ для LLM провайдера
LLM_API_KEY=your_llm_api_key_here

# URL базового API (например, https://openrouter.ai/api/v1)
LLM_BASE_URL=https://openrouter.ai/api/v1

# Название модели (например, anthropic/claude-3.5-sonnet)
LLM_MODEL=anthropic/claude-3.5-sonnet

# =============================================================================
# System Prompt
# =============================================================================
# Путь к файлу с системным промптом (по умолчанию: prompts/system_prompt.txt)
SYSTEM_PROMPT_FILE=prompts/system_prompt.txt

# Альтернативно: системный промпт напрямую (используется если файл не найден)
# SYSTEM_PROMPT="Ты полезный AI-ассистент"

# =============================================================================
# Context Management
# =============================================================================
# Максимальное количество сообщений в контексте (по умолчанию: 20)
MAX_CONTEXT_MESSAGES=20

# =============================================================================
# Database (PostgreSQL)
# =============================================================================
# ВАЖНО: Для Docker используйте хост 'postgres' (имя сервиса в docker-compose.yml)
# Формат: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://systech_user:systech_password@postgres:5432/systech_aidd

# Выводить SQL запросы в логи (True/False, по умолчанию: False)
DATABASE_ECHO=False

# =============================================================================
# API Settings
# =============================================================================
# Хост для API сервера (0.0.0.0 для доступа извне контейнера)
API_HOST=0.0.0.0

# Порт для API сервера (по умолчанию: 8000)
API_PORT=8000

# Режим StatCollector: mock или real (по умолчанию: mock)
STAT_COLLECTOR_MODE=real

