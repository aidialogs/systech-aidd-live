# Пример файла с переменными окружения для проекта systech-aidd-live
# Скопируйте этот файл в ../.env и заполните своими значениями

# ============================================
# Telegram Bot Configuration
# ============================================
# Токен бота от @BotFather в Telegram
BOT_TOKEN=your_bot_token_here

# ============================================
# LLM (Language Model) Configuration
# ============================================
# API ключ для доступа к LLM сервису (OpenRouter, OpenAI, etc.)
LLM_API_KEY=your_api_key_here

# Базовый URL для LLM API
# Примеры:
#   OpenRouter: https://openrouter.ai/api/v1
#   OpenAI: https://api.openai.com/v1
LLM_BASE_URL=https://openrouter.ai/api/v1

# Название модели для использования
# Примеры для OpenRouter:
#   anthropic/claude-3.5-sonnet
#   openai/gpt-4-turbo
#   google/gemini-pro
LLM_MODEL=anthropic/claude-3.5-sonnet

# ============================================
# Database Configuration
# ============================================
# URL подключения к базе данных PostgreSQL
# Формат: postgresql+asyncpg://user:password@host:port/database
# Для Docker: используйте имя сервиса 'postgres' как host
DATABASE_URL=postgresql+asyncpg://systech_user:systech_password@postgres:5432/systech_aidd

# Включить вывод SQL запросов в логи (True/False)
DATABASE_ECHO=False

# ============================================
# System Configuration
# ============================================
# Максимальное количество сообщений в контексте диалога
MAX_CONTEXT_MESSAGES=20

# Путь к файлу с системным промптом
# Для Docker: относительно /app в контейнере
SYSTEM_PROMPT_FILE=prompts/system_prompt.txt

